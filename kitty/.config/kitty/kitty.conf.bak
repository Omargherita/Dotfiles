# ==============================================================================
#              OBSIDIAN COLD MONOCHROME KITTY CONFIG
#       Pure Black, Cool Grey, Crisp White & Dark Cold Steel Tones
# ==============================================================================

# --- Color Theme ---
include themes/cold-frost.conf

# --- Typography & Fonts ---
font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        11.5

# Fine-tune rendering
modify_font cell_height         105%
modify_font underline_position  2
modify_font underline_thickness 150%
disable_ligatures               never
undercurl_style                 thin-sparse

# --- Window Layout & Spacing ---
remember_window_size    yes
initial_window_width    1100
initial_window_height   680
window_padding_width    20 24
placement_strategy      center
hide_window_decorations no
confirm_os_window_close 0

# --- Frosted Glass Blur & Transparency ---
background_opacity          0.82
background_blur             48
dynamic_background_opacity  yes

# --- Cursor ---
cursor_shape                beam
cursor_beam_thickness       1.6
cursor_blink_interval       0.55
cursor_stop_blinking_after  12.0

# Smooth cursor trail
cursor_trail                3
cursor_trail_decay          0.1 0.4
cursor_trail_start_threshold 2

# --- Tab Bar ---
tab_bar_edge            top
tab_bar_style           powerline
tab_powerline_style     slanted
tab_bar_min_tabs        1
tab_bar_margin_width    0
tab_activity_symbol     "● "
tab_title_template      " {index}  {title.split('/')[-1]} "
active_tab_font_style   bold
inactive_tab_font_style normal

# --- Window Borders & Splits ---
draw_window_borders_for_single_window no
draw_minimal_borders                  yes
window_border_width                   1.0pt
active_border_color                   #30363d
inactive_border_color                 #161b22
bell_border_color                     #484f58

# --- Scrollback & Mouse ---
scrollback_lines        10000
mouse_hide_wait         2.0
url_style               straight
open_url_with           default
detect_urls             yes
show_hyperlink_targets  yes
copy_on_select          yes
strip_trailing_spaces   smart
focus_follows_mouse     yes

# --- Visual Clarity ---
enable_audio_bell       no
visual_bell_duration    0.0
window_alert_on_bell    no
bell_on_tab             no

# --- Performance ---
repaint_delay           8
input_delay             2
sync_to_monitor         yes

# --- Keybindings ---
# Config reload
map ctrl+shift+f5 combine : load_config_file : launch --type=overlay --hold sh -c "echo ' Kitty config reloaded!'"

# Font sizing
map ctrl+equal  change_font_size all +1.0
map ctrl+plus   change_font_size all +1.0
map ctrl+minus  change_font_size all -1.0
map ctrl+0      change_font_size all 0

# Tab management
map ctrl+shift+t new_tab_with_cwd
map ctrl+shift+w close_tab
map ctrl+tab           next_tab
map ctrl+shift+tab     previous_tab

# Window split management
map ctrl+shift+enter new_window_with_cwd
map ctrl+shift+d     new_window_with_cwd
map ctrl+shift+q     close_window
map ctrl+shift+]     next_window
map ctrl+shift+[     previous_window

# Transparency controls
map ctrl+shift+u set_background_opacity +0.05
map ctrl+shift+m set_background_opacity -0.05
map ctrl+shift+delete set_background_opacity default
